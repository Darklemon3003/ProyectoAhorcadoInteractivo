<?xml version="1.0" encoding="UTF-8"?>
<!--
    pom muy basico del proyecto.
    Lo uso mas que todo para que VS Code entienda donde estan los .java
    y pueda ejecutar el Main sin ponerse raro con el classpath.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ahorcado</groupId>
    <artifactId>ProyectoAhorcadoInteractivo</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <!-- mi codigo esta directo en src y no en src/main/java -->
        <sourceDirectory>src</sourceDirectory>
    </build>

</project>
